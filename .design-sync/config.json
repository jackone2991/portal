{
  "pkg": "portal-frontend",
  "globalName": "PortalUI",
  "projectId": "37fd7f83-cbf7-42fd-8c68-6085871e701f",
  "shape": "package",
  "srcDir": "src/templates/v1",
  "tsconfig": "tsconfig.ds.json",
  "cssEntry": ".ds-compiled.css",
  "buildCmd": "node .ds-compile-css.mjs",
  "extraEntries": ["./.ds-shims/ds-provider.tsx"],
  "provider": { "component": "DSProvider" },
  "componentSrcMap": {
    "SessionKeeper": null,
    "SvgSprite": null,
    "Modal": null,
    "Field": null,
    "BtnPrimary": null,
    "BtnSecondary": null,
    "Card": null
  },
  "overrides": {
    "CommentItem": { "cardMode": "column" },
    "MasterBase": { "cardMode": "single", "primaryStory": "App" },
    "SidebarCenter": { "cardMode": "column" },
    "ReactionBar": { "cardMode": "column" },
    "HelloPreloader": { "cardMode": "single", "primaryStory": "Overlay" },
    "AddBook": { "cardMode": "single", "primaryStory": "Dialog" },
    "ChatResponsive": { "cardMode": "single", "primaryStory": "Chat" },
    "ChoseFromMyPhoto": { "cardMode": "single", "primaryStory": "Dialog" },
    "UpdateHeaderPhoto": { "cardMode": "single", "primaryStory": "Dialog" }
  },
  "readmeHeader": ".design-sync/conventions.md",
  "dtsPropsFor": {
    "Avatar": "name: string; size?: number; className?: string;",
    "Icon": "name: string; size?: number; className?: string; style?: React.CSSProperties;",
    "AuthForm": "defaultTab?: \"login\" | \"register\";",
    "MasterBase": "children: React.ReactNode;",
    "MasterPublic": "children: React.ReactNode;",
    "FriendRequestsMenu": "open: boolean; onToggle: () => void;",
    "MessagesMenu": "open: boolean; onToggle: () => void;",
    "NotificationsMenu": "open: boolean; onToggle: () => void;",
    "SidebarLeft": "collapsed: boolean; onToggle: () => void;",
    "SidebarRight": "collapsed: boolean; onToggle: () => void;",
    "MoneyDisplay": "amount: number; currency?: string; className?: string; /** Colour negative red / positive green and show an explicit + sign. */ signed?: boolean;",
    "MoneyInput": "value: number; onChange: (minor: number) => void; placeholder?: string; className?: string; id?: string;",
    "PersonDetailView": "id: string;",
    "MediaDetailView": "id: string;"
  }
}
