# Env / secrets
.env
.env.*
!.env.example
*.pem
*.key

# Build output
dist/
build/
out/
.next/
.turbo/
node_modules/

# Go
backend/bin/
backend/*.test
backend/coverage.out

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Generated code. sqlc output is regenerated on build (not committed); the
# OpenAPI codegen IS committed and CI gates its drift against shared/openapi.yaml
# (ADR-10 — spec-first, enforced).
backend/internal/modules/*/repository/*.sql.go

# Docker volumes (when running locally with bind mounts)
data/

# Logs
*.log
logs/

# GitNexus index — keep config, ignore the binary index
.gitnexus/lbug

# design-sync (converter scratch + build output)
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
frontend/.ds-compiled.css

# design-sync npm-install byproduct (repo uses pnpm, no lockfile by design)
frontend/package-lock.json
.mcp.json
# Claude Code local overrides (personal, not shared)
.claude.local.md

# Scraper service runtime artifacts (SPEC-02 P1.8)
scraper/__pycache__/
scraper/downloaded_files/
scraper/*.log
