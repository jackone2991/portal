# Env / secrets
.env
.env.*
!.env.example
*.pem
*.key

# Build output
dist/
build/
out/
.next/
.turbo/
node_modules/

# Go
backend/bin/
backend/*.test
backend/coverage.out

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Generated code. sqlc output is regenerated on build (not committed); the
# OpenAPI codegen IS committed and CI gates its drift against shared/openapi.yaml
# (ADR-10 — spec-first, enforced).
backend/internal/modules/*/repository/*.sql.go

# Docker volumes (when running locally with bind mounts)
data/

# Logs
*.log
logs/

# GitNexus index — keep config, ignore the binary index
.gitnexus/lbug

# design-sync (converter scratch + build output)
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
frontend/.ds-compiled.css

# The frontend's package manager is pnpm (Makefile, Dockerfile, CI) and its
# lockfile IS committed: frontend/pnpm-lock.yaml. An npm lockfile is a
# byproduct of running npm by mistake (design-sync did) and must not be
# tracked next to it - two lockfiles, two dependency graphs. Until 2026-09-11
# the comment here said "no lockfile by design" while CI cached on the pnpm
# lockfile, which is how the frontend and openapi jobs failed at setup for
# two months.
frontend/package-lock.json
.mcp.json
# Claude Code local overrides (personal, not shared)
.claude.local.md

# Scraper service runtime artifacts (SPEC-02 P1.8)
scraper/__pycache__/
scraper/downloaded_files/
scraper/*.log
