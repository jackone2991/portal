# ──────────────────────────────────────────────────────────────────
# Portal — environment template. Copy to `.env` and fill in.
# ──────────────────────────────────────────────────────────────────

# General
APP_ENV=development                 # development | staging | production
APP_DOMAIN=portal.localhost         # base domain (Traefik routes use this)
LOG_LEVEL=debug                     # debug | info | warn | error
APP_TIMEZONE=UTC                    # IANA tz for ALL date display (e.g. Asia/Ho_Chi_Minh). One knob → whole UI.

# ── Postgres ──────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=change-me
# Used by API/worker — usually points at PgBouncer in prod
DATABASE_URL=postgres://portal:change-me@pgbouncer:6432/portal?sslmode=disable
# Used ONLY by the nightly ops backup task (SPEC-09 P0.2). pg_dump needs session
# semantics a transaction pooler breaks, so this MUST bypass PgBouncer and connect
# to Postgres DIRECTLY (postgres:5432). Empty ⇒ the backup self-reports a failed
# run on /ops/status instead of crashing the worker.
BACKUP_DATABASE_URL=postgres://portal:change-me@postgres:5432/portal?sslmode=disable

# ── PgBouncer ─────────────────────────────────────────────────────
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=200
PGBOUNCER_DEFAULT_POOL_SIZE=25

# ── DragonflyDB (Redis-compatible) ────────────────────────────────
REDIS_URL=redis://dragonfly:6379/0
ASYNQ_REDIS_URL=redis://dragonfly:6379/1

# ── Worker concurrency ────────────────────────────────────────────
# Image WebP-variant transcode pool (media:process_image, its own "image" queue).
# Comic zip imports transcode pages in parallel here; higher = faster imports but
# more RAM/CPU (decodes are dimension-capped, SPEC-01 P0.1). Video stays serial on
# the "heavy" pool regardless. Tune to VPS cores; default 3.
IMAGE_CONCURRENCY=3
# Parallel image-ingest workers for the comic zip import (DB+storage, I/O-bound).
# Feeds the transcode pool above; higher = faster ingest but more in-flight image
# buffers + DB connections. Default 4.
IMPORT_INGEST_CONCURRENCY=4

# ── Object storage (S3-compatible) ────────────────────────────────
# The app reads S3_* for ALL object storage. Dev points these at the local
# MinIO container (bytes in ./data/minio); going live = repoint S3_* at R2/S3.
MINIO_ROOT_USER=portal
MINIO_ROOT_PASSWORD=change-me
# Host dir for MinIO's bytes. Default ./data/minio (repo-local). Point it at a
# faster disk if yours is slow — MinIO write speed bounds the whole media/transcode
# pipeline (an NVMe is ~5x an HDD here). Windows: forward slashes, e.g. G:/data/portal/minio
# MINIO_DATA_DIR=./data/minio
S3_ENDPOINT=http://minio:9000      # live: https://<accountid>.r2.cloudflarestorage.com
S3_REGION=us-east-1                # R2: auto
S3_BUCKET=portal-media
S3_ACCESS_KEY=portal               # live: R2/S3 access key
S3_SECRET_KEY=change-me            # live: R2/S3 secret key
S3_USE_PATH_STYLE=true             # MinIO: true · R2/S3: false

# ── Cloudflare R2 (reserved) ──────────────────────────────────────
# Not read by the app yet (S3_* above is the single knob). Kept for a future
# dedicated R2 client / signed CDN URLs.
R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=

# ── Authentication ────────────────────────────────────────────────
# Login is LOCAL password auth (ADR-06) — Portal owns credentials (Argon2id).
# No external IdP: there are no OIDC_* / AUTHENTIK_* variables anymore.

# ── API ───────────────────────────────────────────────────────────
API_PORT=8080
API_BASE_URL=https://api.portal.localhost

# ── JWT signing keys (rotating) ────────────────────────────────────
# Format: kid:base64-secret[,kid:base64-secret...]
# First key is the active signer; later keys remain valid for verification
# during a rotation grace window. Generate with:
#   openssl rand -base64 48 | tr -d '\n'
JWT_SIGNING_KEYS=v1:CHANGE-ME-base64-encoded-32-or-more-bytes
JWT_ISSUER=portal
JWT_AUDIENCE=portal-api
ACCESS_TOKEN_TTL=5m
REFRESH_TOKEN_TTL=24h
PERMISSION_CACHE_TTL=5m

# ── Cookies ────────────────────────────────────────────────────────
# Set to the base domain so the session cookie is shared between the frontend
# (portal.localhost) and API (api.portal.localhost) subdomains.
COOKIE_DOMAIN=portal.localhost
COOKIE_SECURE=true                 # set to false ONLY for plain-http dev
POST_LOGIN_URL=https://portal.localhost/

# Browser origins allowed to make credentialed (cookie) calls to the API. The
# login form POSTs cross-subdomain, so the exact frontend origin must be listed
# (a wildcard is invalid with credentials). Comma-separated.
CORS_ALLOWED_ORIGINS=https://portal.localhost

# ── Password reset (SPEC-04 P0.3) ──────────────────────────────────
# Reset-link base the email points at; the one-time token is appended as ?token=.
PASSWORD_RESET_URL=https://portal.localhost/reset-password
PASSWORD_RESET_TTL=1h

# ── Notifications — email channel (SPEC-04 P0.3) ───────────────────
# Dev = Mailpit (SMTP :1025, no auth; UI at https://mail.${APP_DOMAIN}). Leave
# SMTP_HOST empty to fall back to a log-sink sender (no mail is sent). Prod points
# these at a real relay/provider. NOTIFY_EMAIL_HOURLY_CAP is a global send ceiling
# (budget insurance); 0 = uncapped.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=Portal <no-reply@portal.localhost>
NOTIFY_EMAIL_HOURLY_CAP=200

# ── Frontend ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=https://api.portal.localhost
NEXT_PUBLIC_APP_NAME=Portal
# Active UI template version (frontend/src/templates/registry.ts). Build-time.
NEXT_PUBLIC_TEMPLATE_VERSION=v1
# Weather widget default location (build-time). When set, the weather widget/page
# use this fixed location instead of the browser geolocation prompt. Change these
# to YOUR city's coordinates. Leave lat/lon empty to fall back to browser
# geolocation. Default: Hà Nội.
NEXT_PUBLIC_WEATHER_LAT=21.0278
NEXT_PUBLIC_WEATHER_LON=105.8342
NEXT_PUBLIC_WEATHER_PLACE=Hà Nội

# ── Traefik ───────────────────────────────────────────────────────
ACME_EMAIL=admin@portal.localhost
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$change-me             # htpasswd; double every $ as $$ (compose escaping)
# Per-router cert source. Empty = use local mkcert certs (dev — run `make certs`,
# docker-compose.override.yml mounts them). Set to "letsencrypt" for a real public
# domain (staging/prod). Leave empty here; do NOT delete the line (empty ≠ unset).
TRAEFIK_CERTRESOLVER=

# ── Observability ─────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GLITCHTIP_DSN=

# ── Comic external-source sync (SPEC-02 P1.8) ─────────────────────
# The scraper is a separate Python service (see scraper/) — Cloudflare bypass needs
# a real Chrome, which the Go backend can't do. Leave COMIC_SCRAPER_URL empty to
# disable the sync feature. COMIC_SYNC_SECRET guards the scraper→api callback and
# MUST match on both the api and scraper services (generate: openssl rand -hex 16).
COMIC_SCRAPER_URL=http://scraper:8000
COMIC_SYNC_CALLBACK_URL=http://api:8080/api/v1/internal/comic/sync-callback
COMIC_SYNC_SECRET=change-me-sync-secret
# Sync throughput. One comic's chapters are scraped by SCRAPER_SYNC_WORKERS browsers
# at once (each a real Chrome, ~1GB), so this is both the speed knob and the RAM
# bill — and it multiplies the request rate aimed at the source, so it is the first
# thing to turn down if the site starts challenging. RECONNECT_TIME is how long
# uc-chromedriver stays detached after each navigation to stay unfingerprinted:
# lower is faster, too low gets you the "Just a moment..." page.
SCRAPER_SYNC_WORKERS=3
SCRAPER_RECONNECT_TIME=3
SCRAPER_LAZY_TIMEOUT=12
SCRAPER_DOWNLOAD_WORKERS=4
SCRAPER_BATCH_SIZE=1
# SSRF guard for sync sources. Comma-separated host allowlist; a host matches
# exactly or as a subdomain. Leave EMPTY to allow any public host — either way,
# URLs resolving to loopback/private/link-local/CGNAT/metadata addresses are
# always rejected, at source-create, at sync-trigger, and again in the scraper.
# truyenqq rotates mirror domains: truyenqqko.com is what the existing sources
# actually sync from, truyenqqno.com is what the UI placeholder suggests. Both are
# listed so neither is rejected — add a new mirror here when the site moves again.
COMIC_SOURCE_ALLOWLIST=truyenqqko.com,truyenqqno.com
